{
  "name": "@aether/files",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Ordinary browser document files and plain-file crash recovery; no Studio or SQL dependency",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "npm run build && node tests/browser.mjs"
  },
  "dependencies": {
    "@aether/protocol": "file:vendor/aether-protocol-0.1.0-alpha.9.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3"
  }
}
