{
  "$schema": "aether-theme/v1",
  "id": "aether-studio",
  "name": "Aether Studio",
  "description": "The ported native studio palette: neutral graphite panels, SF type, a blue accent. Dark is the mockup; light is its daylight twin.",
  "modes": {
    "dark": {
      "color-bg-app": "#0e1013",
      "color-bg-shell": "#171a20",
      "color-bg-bar": "#171a20",
      "color-bg-panel": "#171a20",
      "color-bg-rail": "#171a20",
      "color-bg-inset": "#1e222a",
      "color-bg-control": "#1e222a",
      "color-bg-control-hover": "#2a2f38",
      "color-bg-hover": "rgba(255, 255, 255, 0.06)",
      "color-bg-row-hover": "rgba(255, 255, 255, 0.04)",
      "color-bg-selected": "#4c9dff",
      "color-text-on-selected": "#ffffff",
      "color-border": "rgba(255, 255, 255, 0.07)",
      "color-border-subtle": "rgba(255, 255, 255, 0.05)",
      "color-border-control": "rgba(255, 255, 255, 0.12)",
      "color-border-control-hover": "#4c9dff",
      "color-border-focus": "#4c9dff",
      "color-text": "#e7e9ed",
      "color-text-soft": "#c9cdd4",
      "color-text-dim": "#9aa1ab",
      "color-text-faint": "#646b76",
      "color-accent": "#4c9dff",
      "color-accent-strong": "#2e6bf6",
      "color-accent-icon": "#4c9dff",
      "color-selection-edge": "#4c9dff",
      "color-shadow": "#000000",
      "color-scrim": "rgba(0, 0, 0, 0.5)",
      "color-ok": "#4cd07a",
      "color-warn": "#ff8a3d",
      "color-error": "#ff5a5f",
      "color-part": "#36d6c3",
      "color-joint": "#8b87ff",
      "color-hardware": "#ff8a3d",
      "viewport-bg-top": "#1e232b",
      "viewport-bg-bottom": "#0b0d11",
      "viewport-grid": "rgba(255, 255, 255, 0.04)",
      "viewport-part": "#474e59",
      "viewport-part-shade": "#262b32",
      "viewport-cavity": "#14171c",
      "viewport-selection": "#4c9dff",
      "viewport-hover": "#7fbcff"
    },
    "light": {
      "color-bg-app": "#f2f4f8",
      "color-bg-shell": "#ffffff",
      "color-bg-bar": "#ffffff",
      "color-bg-panel": "#ffffff",
      "color-bg-rail": "#f7f8fb",
      "color-bg-inset": "#edf0f5",
      "color-bg-control": "#edf0f5",
      "color-bg-control-hover": "#e2e6ee",
      "color-bg-hover": "rgba(0, 0, 0, 0.05)",
      "color-bg-row-hover": "rgba(0, 0, 0, 0.03)",
      "color-bg-selected": "#2e6bf6",
      "color-text-on-selected": "#ffffff",
      "color-border": "rgba(0, 0, 0, 0.08)",
      "color-border-subtle": "rgba(0, 0, 0, 0.05)",
      "color-border-control": "rgba(0, 0, 0, 0.13)",
      "color-border-control-hover": "#2e6bf6",
      "color-border-focus": "#2e6bf6",
      "color-text": "#1a1e27",
      "color-text-soft": "#3a404b",
      "color-text-dim": "#5b636f",
      "color-text-faint": "#9ba2ad",
      "color-accent": "#2e6bf6",
      "color-accent-strong": "#1f55d6",
      "color-accent-icon": "#2e6bf6",
      "color-selection-edge": "#2e6bf6",
      "color-shadow": "#1a1e27",
      "color-scrim": "rgba(20, 24, 32, 0.35)",
      "color-ok": "#27b36a",
      "color-warn": "#ec6d1f",
      "color-error": "#e5484d",
      "color-part": "#11a594",
      "color-joint": "#5b54e0",
      "color-hardware": "#ec6d1f",
      "viewport-bg-top": "#f4f6fa",
      "viewport-bg-bottom": "#e7ebf2",
      "viewport-grid": "rgba(0, 0, 0, 0.06)",
      "viewport-part": "#fdfdfe",
      "viewport-part-shade": "#c7ceda",
      "viewport-cavity": "#aeb6c4",
      "viewport-selection": "#2e6bf6",
      "viewport-hover": "#5b8ef7"
    }
  },
  "geometry": {
    "radius-panel": "10px",
    "radius-control": "8px",
    "radius-button": "8px"
  },
  "font": {
    "font-family": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Segoe UI\", Inter, system-ui, sans-serif"
  },
  "effects": {
    "control-shadow": "inset 0 1px 0 color-mix(in srgb, var(--aether-color-text) 6%, transparent)",
    "control-hover-shadow": "inset 0 1px 0 color-mix(in srgb, var(--aether-color-text) 10%, transparent)"
  }
}
