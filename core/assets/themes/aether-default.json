  "geometry": {
    "radius-control": "7px",
    "radius-button": "8px",
    "radius-field": "6px",
    "radius-row": "6px",
    "space-1": "3px",
    "space-2": "5px",
    "space-3": "7px",
    "space-4": "9px",
    "space-5": "13px",
    "size-topbar": "56px",
    "size-ribbon": "72px",
    "size-statusbar": "27px",
    "size-rail": "42px",
    "size-sidebar": "250px",
    "size-row": "36px",
    "size-icon-slot": "36px",
    "size-grid": "4px",
    "radius-panel": "10px",
    "radius-pill": "999px",
    "size-control": "28px",
    "control-padding-x": "11px",
    "control-padding-y": "8px",
    "control-border-width": "1px",
    "selection-cell-inset": "0px",
    "selection-cell-gap": "0px",
    "selection-cell-radius": "0px"
  },
  "font": {
    "font-family": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", Inter, ui-sans-serif, sans-serif",
    "font-size-body": "12px",
    "font-size-label": "10px",
    "font-size-caption": "9px",
    "font-size-micro": "8px",
    "font-weight-strong": "650",
    "font-letter-caps": "0.09em",
    "font-mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
  },
  "effects": {
    "shadow-1": "0 1px 2px color-mix(in srgb, var(--aether-color-shadow) 35%, transparent)",
    "shadow-2": "0 8px 22px color-mix(in srgb, var(--aether-color-shadow) 30%, transparent)",
    "shadow-3": "0 24px 70px color-mix(in srgb, var(--aether-color-shadow) 55%, transparent)",
    "material": "color-mix(in srgb, var(--aether-color-bg-panel) 75%, transparent)",
    "motion-fast": "120ms",
    "motion-base": "180ms",
    "control-shadow": "none",
    "control-hover-shadow": "none",
    "motion-slow": "260ms",
    "motion-ease": "cubic-bezier(0.2, 0, 0, 1)",
    "motion-ease-out": "cubic-bezier(0, 0, 0, 1)",
    "motion-ease-spring": "cubic-bezier(0.2, 1.25, 0.35, 1)"
  },
  "touch": {
    "size-control": "44px",
    "size-row": "44px",
    "size-icon-slot": "44px",
    "size-rail": "52px",
    "size-statusbar": "36px",
    "control-padding-x": "14px",
    "control-padding-y": "12px",
    "space-2": "7px",
    "space-3": "9px",
    "radius-control": "9px",
    "radius-button": "10px"
  }
